-- ---------------------------------------------------------------------
-- 3. Procedimientos almacenados nuevos
-- ---------------------------------------------------------------------
IF OBJECT_ID('dbo.ObtenerPermisosxUsuario') IS NOT NULL DROP PROCEDURE [dbo].[ObtenerPermisosxUsuario];
GO
-- RF-06: codigos de permiso del rol del usuario (la interfaz muestra u oculta opciones con esto)
CREATE PROCEDURE [dbo].[ObtenerPermisosxUsuario]
@IdUsuario UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    SELECT p.Codigo
    FROM [dbo].[Usuarios] u
    INNER JOIN [dbo].[RolesxPermiso] rp ON rp.IdRol = u.IdRol
    INNER JOIN [dbo].[Permisos] p ON p.Id = rp.IdPermiso
    WHERE u.Id = @IdUsuario AND u.Activo = 1
    ORDER BY p.Codigo;
END
GO

IF OBJECT_ID('dbo.VerificarPermiso') IS NOT NULL DROP PROCEDURE [dbo].[VerificarPermiso];
GO
-- RF-06: 1 si el rol del usuario (activo) tiene el permiso. Se lee en cada peticion,
-- por eso un cambio de rol o de privilegios se aplica de inmediato.
CREATE PROCEDURE [dbo].[VerificarPermiso]
@IdUsuario UNIQUEIDENTIFIER,
@Permiso   VARCHAR(60)
AS
BEGIN
    SET NOCOUNT ON;
    SELECT CAST(CASE WHEN EXISTS (
        SELECT 1
        FROM [dbo].[Usuarios] u
        INNER JOIN [dbo].[RolesxPermiso] rp ON rp.IdRol = u.IdRol
        INNER JOIN [dbo].[Permisos] p ON p.Id = rp.IdPermiso
        WHERE u.Id = @IdUsuario AND u.Activo = 1 AND p.Codigo = @Permiso)
        THEN 1 ELSE 0 END AS BIT) AS TienePermiso;
END
GO

-- ---------------------------------------------------------------------
-- 4. ESTADO DESPUES (evidencia)
-- ---------------------------------------------------------------------
PRINT '=== ESTADO DESPUES ===';

SELECT 'DESPUES - Roles' AS Evidencia, Id, Nombre, Descripcion FROM [dbo].[Roles] ORDER BY Id;

SELECT 'DESPUES - Modulos por rol' AS Evidencia, r.Id AS IdRol, r.Nombre AS Rol, m.Nombre AS Modulo
FROM [dbo].[Roles] r
LEFT JOIN [dbo].[RolesxModulo] rm ON rm.IdRol = r.Id
LEFT JOIN [dbo].[Modulos] m ON m.Id = rm.IdModulo
ORDER BY r.Id, m.Nombre;

SELECT 'DESPUES - Cantidad de privilegios por rol' AS Evidencia, r.Id AS IdRol, r.Nombre AS Rol, COUNT(rp.IdPermiso) AS Privilegios
FROM [dbo].[Roles] r
LEFT JOIN [dbo].[RolesxPermiso] rp ON rp.IdRol = r.Id
GROUP BY r.Id, r.Nombre
ORDER BY r.Id;

SELECT 'DESPUES - Privilegios por rol (detalle)' AS Evidencia, r.Nombre AS Rol, m.Nombre AS Modulo, p.Codigo AS Permiso, p.Historia
FROM [dbo].[RolesxPermiso] rp
INNER JOIN [dbo].[Roles] r ON r.Id = rp.IdRol
INNER JOIN [dbo].[Permisos] p ON p.Id = rp.IdPermiso
INNER JOIN [dbo].[Modulos] m ON m.Id = p.IdModulo
WHERE r.Id IN (2, 3, 4)
ORDER BY r.Id, m.Nombre, p.Codigo;
GO
