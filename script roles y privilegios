/* =====================================================================
   ANKH - Roles y privilegios (Administrador, Vendedor, Encargado de
   Inventario y Usuario)
   ===================================================================== */
USE MacrobioticaDB;
GO

PRINT '=== ESTADO ANTES ===';
SELECT 'ANTES - Roles' AS Evidencia, Id, Nombre, Descripcion FROM [dbo].[Roles] ORDER BY Id;
SELECT 'ANTES - Modulos por rol' AS Evidencia, r.Id AS IdRol, r.Nombre AS Rol, m.Nombre AS Modulo
FROM [dbo].[Roles] r
