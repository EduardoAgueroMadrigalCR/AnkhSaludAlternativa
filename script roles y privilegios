-- ---------------------------------------------------------------------
-- 1. Tablas nuevas
-- ---------------------------------------------------------------------
IF OBJECT_ID('dbo.Permisos', 'U') IS NULL
BEGIN
-- Catalogo de privilegios (acciones) del sistema. Cada permiso pertenece a un modulo
-- y referencia la historia de usuario que lo origina (AN02_Historias_de_Usuario).
CREATE TABLE [dbo].[Permisos] (
    [Id]          INT IDENTITY(1,1) NOT NULL,
    [Codigo]      VARCHAR(60)       NOT NULL,
    [Descripcion] VARCHAR(200)      NOT NULL,
    [IdModulo]    INT               NOT NULL,
    [Historia]    VARCHAR(20)       NULL,
    CONSTRAINT [PK_Permisos] PRIMARY KEY CLUSTERED ([Id] ASC),
    CONSTRAINT [UQ_Permisos_Codigo] UNIQUE ([Codigo]),
    CONSTRAINT [FK_Permisos_Modulos] FOREIGN KEY ([IdModulo]) REFERENCES [dbo].[Modulos] ([Id])
);
END
GO

IF OBJECT_ID('dbo.RolesxPermiso', 'U') IS NULL
BEGIN
-- Privilegios concedidos a cada rol (relacion N:M entre Roles y Permisos).
CREATE TABLE [dbo].[RolesxPermiso] (
    [IdRol]     INT NOT NULL,
    [IdPermiso] INT NOT NULL,
    CONSTRAINT [PK_RolesxPermiso] PRIMARY KEY CLUSTERED ([IdRol] ASC, [IdPermiso] ASC),
    CONSTRAINT [FK_RolesxPermiso_Roles]    FOREIGN KEY ([IdRol])     REFERENCES [dbo].[Roles] ([Id]),
    CONSTRAINT [FK_RolesxPermiso_Permisos] FOREIGN KEY ([IdPermiso]) REFERENCES [dbo].[Permisos] ([Id])
);
END
GO

